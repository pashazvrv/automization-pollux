# Скопируйте в .env и заполните. Не коммитить .env.
# LiteLLM-гейтвей (gigagateway): OpenAI-совместимый эндпоинт, авторизация X-Api-Key.
LLM_URL=https://gigagateway.eye.salute.ru/litellm/v1/chat/completions
LLM_KEY=
LLM_PROVIDER=alibaba        # значения provider.only через запятую; пусто — поле не отправляется
LLM_MODEL=                  # разметчик (S1–S4), например имя модели на гейтвее
LLM_MODEL_JUDGE=            # судья (S5), фиксер (S6) и оценщик в eval_v4; пусто = как LLM_MODEL
LLM_MODEL_GLM=              # третья модель для сравнений; пусто = как LLM_MODEL
LLM_USE_CURL=0              # 1 = вызывать через системный curl (если у Python-SSL проблемы)
